<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/nav_emprendimiento">

    <fragment
        android:id="@+id/nav_metricas"
        android:name="com.example.projectcapstone.ui.Metricas.MetricasFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_metricas" />

    <fragment
        android:id="@+id/nav_emprendimiento"
        android:name="com.example.projectcapstone.ui.Emprendimiento.EmprendimientoFragment"
        android:label="@string/menu_emprendimiento"
        tools:layout="@layout/fragment_emprendimiento" >
        <action
            android:id="@+id/action_nav_emprendimiento_to_nuevoEmprendimientoFragment"
            app:destination="@id/nuevoEmprendimientoFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_publicaciones"
        android:name="com.example.projectcapstone.ui.Publicaciones.PublicacionesFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_publicaciones" />
    <fragment
        android:id="@+id/nav_crear_cuenta"
        android:name="com.example.projectcapstone.ui.Autenticacion.CrearCuenta.CrearCuenta"
        android:label="CrearCuenta" >
        <action
            android:id="@+id/action_nav_crear_cuenta_to_nav_validar_correo_crear"
            app:destination="@id/nav_validar_correo_crear" />
        <action
            android:id="@+id/action_nav_crear_cuenta_to_nav_start_upn"
            app:destination="@id/nav_start_upn" />
    </fragment>
    <fragment
        android:id="@+id/nav_inicio_sesion"
        android:name="com.example.projectcapstone.ui.Autenticacion.InicioSesion.InicioSesion"
        android:label="fragment_inicio_sesion"
        tools:layout="@layout/fragment_inicio_sesion" >
        <action
            android:id="@+id/action_nav_inicio_sesion_to_nav_inicio"
            app:destination="@id/nav_inicio" />
        <action
            android:id="@+id/action_nav_inicio_sesion_to_nav_validar_correo_recuperar"
            app:destination="@id/nav_validar_correo_recuperar" />
    </fragment>
    <fragment
        android:id="@+id/nav_start_upn"
        android:name="com.example.projectcapstone.ui.Autenticacion.InicioSesion.StartUpn"
        android:label="fragment_start"
        tools:layout="@layout/fragment_start" >
        <action
            android:id="@+id/action_nav_start_upn_to_nav_crear_cuenta"
            app:destination="@id/nav_crear_cuenta" />
        <action
            android:id="@+id/action_nav_start_upn_to_nav_inicio_sesion"
            app:destination="@id/nav_inicio_sesion" />
    </fragment>
    <fragment
        android:id="@+id/nav_validar_correo_recuperar"
        android:name="com.example.projectcapstone.ui.Autenticacion.RecuperarPassword.ValidarCorreoRecuperar"
        android:label="fragment_confirmar_correo"
        tools:layout="@layout/fragment_validar_correo_recuperar" >
        <action
            android:id="@+id/action_nav_validar_correo_to_nav_confirmar_password"
            app:destination="@id/nav_confirmar_password" />
    </fragment>
    <fragment
        android:id="@+id/nav_confirmar_password"
        android:name="com.example.projectcapstone.ui.Autenticacion.RecuperarPassword.ConfirmarPassword"
        android:label="fragment_confirmar_password"
        tools:layout="@layout/fragment_confirmar_password" >
        <action
            android:id="@+id/action_nav_confirmar_password_to_nav_inicio"
            app:destination="@id/nav_inicio" />
    </fragment>
    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.example.projectcapstone.ui.Inicio.InicioFragment"
        android:label="fragment_inicio"
        tools:layout="@layout/fragment_inicio" />
    <fragment
        android:id="@+id/nav_validar_correo_crear"
        android:name="com.example.projectcapstone.ui.Autenticacion.CrearCuenta.ValidarCorreoCrear"
        android:label="fragment_validar_correo_password"
        tools:layout="@layout/fragment_validar_correo_crear" >
        <action
            android:id="@+id/action_nav_validar_correo_crear_to_nav_inicio"
            app:destination="@id/nav_inicio" />
    </fragment>
    <fragment
        android:id="@+id/nav_notificaciones"
        android:name="com.example.projectcapstone.ui.Notificaciones.NotificacionesFragment"
        android:label="fragment_notificaciones"
        tools:layout="@layout/fragment_notificaciones" />
    <fragment
        android:id="@+id/nav_favoritos"
        android:name="com.example.projectcapstone.ui.Favoritos.FavoritosFragment"
        android:label="fragment_favoritos"
        tools:layout="@layout/fragment_favoritos" />
    <fragment
        android:id="@+id/nav_perfil"
        android:name="com.example.projectcapstone.ui.Perfil.PerfilFragment"
        android:label="fragment_perfil"
        tools:layout="@layout/fragment_perfil" />
    <fragment
        android:id="@+id/nav_colaboraciones"
        android:name="com.example.projectcapstone.ui.Colaboraciones.ColaboracionesFragment"
        android:label="fragment_colaboraciones"
        tools:layout="@layout/fragment_colaboraciones" />
    <fragment
        android:id="@+id/nav_soporte"
        android:name="com.example.projectcapstone.ui.Soporte.SoporteFragment"
        android:label="fragment_soporte"
        tools:layout="@layout/fragment_soporte" />
    <fragment
        android:id="@+id/nuevoEmprendimientoFragment"
        android:name="com.example.projectcapstone.ui.Emprendimiento.NuevoEmprendimientoFragment"
        android:label="fragment_nuevo_emprendimiento"
        tools:layout="@layout/fragment_nuevo_emprendimiento" />
</navigation>