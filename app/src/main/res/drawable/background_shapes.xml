<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo base blanco -->
    <item>
        <color android:color="@color/white" />
    </item>

    <!-- Forma grande superior izquierda -->
    <item
        android:top="-100dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="@color/orange_primary" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>

    <!-- Forma mediana superior izquierda (overlay) -->
    <item
        android:top="-50dp"
        android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="@color/background_overlay" />
            <size android:width="200dp" android:height="200dp" />
        </shape>
    </item>

    <!-- Forma pequeña superior derecha -->
    <item
        android:top="100dp"
        android:right="-80dp">
        <shape android:shape="oval">
            <solid android:color="@color/orange_secondary" />
            <size android:width="160dp" android:height="160dp" />
        </shape>
    </item>

    <!-- Gradiente sutil -->
    <item android:top="0dp">
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@android:color/transparent"
                android:endColor="@color/background_overlay" />
        </shape>
    </item>

</layer-list>