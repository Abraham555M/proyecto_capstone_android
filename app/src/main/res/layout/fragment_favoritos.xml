<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA"
    tools:context=".ui.Favoritos.FavoritosFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="8dp">

            <!-- 🔍 Barra de búsqueda -->
            <LinearLayout
                android:id="@+id/layoutSearchFavoritos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_buscar"
                            app:tint="#9E9E9E"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etSearchFavoritos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Buscar en tus favoritos"
                            android:textSize="15sp"
                            android:textColor="#212121"
                            android:textColorHint="#BDBDBD"
                            android:background="@null"
                            android:maxLines="1"
                            android:inputType="text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 🏷️ Sección de Categorías -->
            <LinearLayout
                android:id="@+id/layoutCategoriasSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categorías"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:paddingBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoriaFavoritos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="2dp"
                    android:paddingBottom="2dp"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_categoria_inicio" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:id="@+id/dividerFavoritos"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="20dp" />

            <!-- 📄 Sección de publicaciones favoritas -->
            <!-- 📄 Sección de publicaciones favoritas -->
            <LinearLayout
                android:id="@+id/layoutPublicacionesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publicaciones guardadas"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="12dp" />

                <!-- Contenedor para lista Y estado vacío -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="300dp">

                    <!-- Lista de publicaciones favoritas -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPublicacionesFavoritos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp"
                        tools:listitem="@layout/item_publicacion_favorito" />

                    <!-- Vista vacía LOCAL (solo para esta sección) -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyPublicaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:layout_gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/ic_empty_folder"
                            android:contentDescription="Sin publicaciones"
                            app:tint="#BDBDBD"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:id="@+id/tvEmptyPublicacionesTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sin favoritos aquí"
                            android:textSize="16sp"
                            android:textColor="#757575"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/tvEmptyPublicacionesSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No hay favoritos en esta categoría"
                            android:textSize="14sp"
                            android:textColor="#9E9E9E"
                            android:gravity="center"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 💬 Vista vacía -->
        <LinearLayout
            android:id="@+id/layoutEmptyFavoritos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_empty_folder"
                android:contentDescription="Sin favoritos"
                app:tint="#BDBDBD"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyFavoritosTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aún no tienes favoritos"
                android:textSize="16sp"
                android:textColor="#757575"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvEmptyFavoritosSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guarda las publicaciones que te gusten para verlas más tarde"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>