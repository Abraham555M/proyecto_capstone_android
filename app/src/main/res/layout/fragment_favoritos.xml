<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".ui.Favoritos.FavoritosFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🩷 Barra de búsqueda -->
        <LinearLayout
            android:id="@+id/layoutSearchFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@color/white">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_buscar"
                        android:layout_marginEnd="8dp"
                        android:alpha="0.6" />

                    <EditText
                        android:id="@+id/etSearchFavoritos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Buscar en tus favoritos"
                        android:textSize="16sp"
                        android:textColorHint="@color/gray_medium"
                        android:background="@null"
                        android:maxLines="1" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvBuscarFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Buscar"
                android:textSize="16sp"
                android:textColor="@color/gray_dark"
                android:gravity="center"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- 🏷 RecyclerView de Categorías -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoriaFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:orientation="horizontal"
            tools:listitem="@layout/item_categoria_inicio" />

        <!-- 🧾 RecyclerView de Publicaciones favoritas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPublicacionesFavoritos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_publicacion_favorito" />

        <!-- 💬 Estado vacío mejorado -->
        <LinearLayout
            android:id="@+id/layoutEmptyFavoritos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgEmptyFavoritos"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_vacio_publicacion"
                android:contentDescription="Sin favoritos"
                android:alpha="0.7"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyFavoritosTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aún no tienes favoritos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmptyFavoritosSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guarda tus publicaciones favoritas para verlas más tarde 💕"
                android:textSize="15sp"
                android:textColor="@color/gray_medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textAlignment="center" />

        </LinearLayout>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>
