<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Formas decorativas de fondo -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-50dp"
        android:layout_marginStart="-50dp"
        android:background="@drawable/circle_orange_large" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="80dp"
        android:layout_marginStart="100dp"
        android:background="@drawable/circle_yellow_medium" />

    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="200dp"
        android:layout_marginEnd="-20dp"
        android:background="@drawable/circle_orange_small" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Avatar circular con fondo rosado -->
        <FrameLayout
            android:id="@+id/flAvatarContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/circle_background_pink"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="100dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user_avatar"
                app:tint="@color/black"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_image_background" />

        </FrameLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmación Correo"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/flAvatarContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ingresa el código que hemos enviado a tu correo institucional"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <!-- Email mostrado -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="xxxxxxxx@upn.pe"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Contenedor para los círculos del código -->
        <LinearLayout
            android:id="@+id/llCodigoCirculos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp">

            <!-- Círculo 1 -->
            <TextView
                android:id="@+id/tvDigito1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_code_background"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#1F2937"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <!-- Círculo 2 -->
            <TextView
                android:id="@+id/tvDigito2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_code_background"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#1F2937"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <!-- Círculo 3 -->
            <TextView
                android:id="@+id/tvDigito3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_code_background"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#1F2937"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <!-- Círculo 4 -->
            <TextView
                android:id="@+id/tvDigito4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_code_background"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#1F2937"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Campo código oculto (para capturar input) -->
        <EditText
            android:id="@+id/etCodigo"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:inputType="number"
            android:maxLength="4"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/llCodigoCirculos"
            app:layout_constraintStart_toStartOf="@id/llCodigoCirculos" />

        <!-- Botón validar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnValidarCodigo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Validar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="#FBAE3C"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/llCodigoCirculos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="60dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <!-- Botón cancelar -->
        <TextView
            android:id="@+id/btnCancelarCodigo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:padding="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/btnValidarCodigo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>