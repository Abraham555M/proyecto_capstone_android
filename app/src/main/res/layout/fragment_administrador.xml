<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    tools:context=".ui.Administrador.AdministradorFragment">

    <!-- ⚙️ Contenedor principal con Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 🧭 Tabs para las secciones -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/orange_button"
            app:tabSelectedTextColor="@color/orange_button"
            app:tabTextColor="#9E9E9E"
            android:background="@android:color/white"
            android:elevation="2dp"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <!-- 📂 ViewPager para mostrar cada sección -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerAdmin"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_reporte" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>