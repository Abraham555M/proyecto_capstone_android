<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Avatar + Nombre + Opciones + Tiempo -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Avatar con borde naranja -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgUsuario"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_user_avatar"
                app:civ_border_width="2dp"
                app:civ_border_color="#FBAE3C" />

            <!-- Container de Nombre y Tiempo -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/btnOpciones"
                android:layout_toEndOf="@+id/imgUsuario"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sandra Gómez"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hace 2h"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Botón de opciones -->
            <ImageView
                android:id="@+id/btnOpciones"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_opciones"
                app:tint="#BDBDBD"
                android:contentDescription="Opciones"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp" />
        </RelativeLayout>

        <!-- Mensaje de colaboración -->
        <TextView
            android:id="@+id/tvMensajeColaboracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A Sandra le gusta tu trabajo y quiere colaborar contigo. ¿Deseas aceptar?"
            android:textColor="#424242"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- Botones de acción -->
        <LinearLayout
            android:id="@+id/layoutBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Rechazar"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:paddingHorizontal="20dp"
                app:cornerRadius="20dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                android:textColor="#757575"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Aceptar"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:paddingHorizontal="24dp"
                app:cornerRadius="20dp"
                app:backgroundTint="#FBAE3C"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Mensaje de confirmación -->
        <LinearLayout
            android:id="@+id/layoutConfirmacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="#4CAF50"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvConfirmacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Ahora son colaboradores, felicitaciones!"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>