<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#FAFAFA"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Imagen circular -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgUsuario"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_user_avatar"
            app:civ_border_width="2dp"
            app:civ_border_color="#FFC107"
            android:layout_marginEnd="12dp" />

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Encabezado con nombre y opciones -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/btnOpciones"
                    android:text="Sandra Gómez"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/btnOpciones"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_opciones"
                    app:tint="#9E9E9E"
                    android:contentDescription="Opciones"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp" />
            </RelativeLayout>

            <!-- Mensaje -->
            <TextView
                android:id="@+id/tvMensajeColaboracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A Sandra le gusta tu trabajo y quiere colaborar contigo. ¿Deseas aceptar?"
                android:textColor="#424242"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="6dp" />

            <!-- Botones -->
            <LinearLayout
                android:id="@+id/layoutBotones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAceptar"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="Aceptar"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp"
                    app:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRechazar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Rechazar"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E53935"
                    app:strokeWidth="1dp"
                    android:textColor="#E53935" />
            </LinearLayout>

            <!-- Confirmación -->
            <TextView
                android:id="@+id/tvConfirmacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Ahora son colaboradores, felicitaciones!"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <!-- Tiempo -->
            <TextView
                android:id="@+id/tvTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 2h"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
