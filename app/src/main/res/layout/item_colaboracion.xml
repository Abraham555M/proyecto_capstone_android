<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="3dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical"
        android:background="@android:color/white">

        <!-- Imagen circular del usuario -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgUsuario"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_user_avatar"
            app:civ_border_width="2dp"
            app:civ_border_color="#FBAE3C"
            android:layout_marginEnd="10dp" />

        <!-- Contenedor principal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Encabezado -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/btnOpciones"
                    android:text="Sandra Gómez"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/btnOpciones"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_opciones"
                    android:contentDescription="Opciones"
                    app:tint="#BDBDBD"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="5dp" />
            </RelativeLayout>

            <!-- Mensaje -->
            <TextView
                android:id="@+id/tvMensajeColaboracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A Sandra le gusta tu trabajo y quiere colaborar contigo. ¿Deseas aceptar?"
                android:textColor="#424242"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="4dp" />

            <!-- Botones -->
            <LinearLayout
                android:id="@+id/layoutBotones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <Button
                    android:id="@+id/btnAceptar"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#4CAF50"
                    android:text="Aceptar"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRechazar"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:backgroundTint="#E53935"
                    android:text="Rechazar"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Texto confirmación -->
            <TextView
                android:id="@+id/tvConfirmacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Ahora son colaboradores, felicitaciones!"
                android:textColor="#FF9800"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- Tiempo -->
            <TextView
                android:id="@+id/tvTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 2h"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
