<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:elevation="3dp"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:layout_gravity="center"
    android:clipToOutline="true"
    android:backgroundTint="#FFFFFF"
    android:backgroundTintMode="src_over">

    <!-- Imagen del usuario -->
    <ImageView
        android:id="@+id/imgUsuario"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_inicio"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"
        android:background="@drawable/circle_shape" />

    <!-- Contenedor de texto y botones -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Mensaje -->
        <TextView
            android:id="@+id/tvMensajeColaboracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A Sandra le gusta tu trabajo y quiere colaborar contigo. ¿Deseas aceptar?"
            android:textSize="15sp"
            android:textColor="#333" />

        <!-- Botones visibles solo si est_colaboracion = 0 -->
        <LinearLayout
            android:id="@+id/layoutBotones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnAceptar"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#4CAF50"
                android:text="Aceptar"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRechazar"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:backgroundTint="#E53935"
                android:text="Rechazar"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Texto visible si est_colaboracion = 1 -->
        <TextView
            android:id="@+id/tvConfirmacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Ahora son colaboradores, felicitaciones!"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Menú o más opciones -->
    <ImageView
        android:id="@+id/btnOpciones"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_opciones"
        android:contentDescription="Opciones" />

</LinearLayout>
