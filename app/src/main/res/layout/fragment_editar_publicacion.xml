<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.Publicaciones.EditarPublicacionFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white">

        <!-- Imagen principal -->
        <FrameLayout
            android:id="@+id/containerUploadE"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:background="#F2F2F2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgUploadE"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:contentDescription="Imagen seleccionada" />

            <LinearLayout
                android:id="@+id/uploadSectionE"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_menu_descargar"
                    android:tint="@android:color/darker_gray"
                    android:contentDescription="Icono de subir foto" />

                <TextView
                    android:id="@+id/txtUploadE"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Agregar foto"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvNombreE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Título de publicación"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/containerUploadE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"/>

        <EditText
            android:id="@+id/etNombrePublicacionE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nombre publicación"
            android:backgroundTint="@android:color/darker_gray"
            app:layout_constraintTop_toBottomOf="@id/tvNombreE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"/>

        <!-- Tipo -->
        <TextView
            android:id="@+id/tvTipoPublicacionE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tipo de publicación"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/etNombrePublicacionE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"/>

        <Spinner
            android:id="@+id/spTipoPublicacionE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTipoPublicacionE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"/>

        <!-- CONTENEDOR DINÁMICO -->
        <FrameLayout
            android:id="@+id/containerFormE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/spTipoPublicacionE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp">

            <!-- Producto -->
            <LinearLayout
                android:id="@+id/layoutProductoE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Campos Producto -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Precio del producto"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etPrecioPublicacionE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Precio"
                    android:inputType="numberDecimal"
                    android:backgroundTint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stock"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etStockPublicacionE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Stock"
                    android:inputType="number"
                    android:backgroundTint="@android:color/darker_gray"/>
            </LinearLayout>

            <!-- Evento -->
            <LinearLayout
                android:id="@+id/layoutEventoE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha del evento"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etFechaEventoE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="dd/mm/aaaa"
                    android:inputType="date"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lugar del evento"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etLugarEventoE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Lugar"
                    android:backgroundTint="@android:color/darker_gray"/>
            </LinearLayout>

            <!-- Promoción -->
            <LinearLayout
                android:id="@+id/layoutPromocionE"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha inicio"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etFechaInicioE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="dd/mm/aaaa"
                    android:inputType="date"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha fin"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etFechaFinE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="dd/mm/aaaa"
                    android:inputType="date"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descuento (%)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"/>
                <EditText
                    android:id="@+id/etDescuentoE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: 20"
                    android:inputType="number"
                    android:backgroundTint="@android:color/darker_gray"/>
            </LinearLayout>

        </FrameLayout>

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcionE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/containerFormE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"/>

        <EditText
            android:id="@+id/etDescripcionE"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:hint="Escribe la descripción aquí..."
            android:gravity="top|start"
            android:backgroundTint="@android:color/darker_gray"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="24dp"/>

        <!-- Botón -->
        <Button
            android:id="@+id/btnCrearE"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Actualizar"
            android:backgroundTint="#F4A027"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/etDescripcionE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="48dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>