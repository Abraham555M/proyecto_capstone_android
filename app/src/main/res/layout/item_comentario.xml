<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Avatar del usuario -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_comment_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_user_avatar"
        app:civ_border_width="2dp"
        app:civ_border_color="@color/purple_200"
        android:layout_marginEnd="10dp" />

    <!-- Contenedor del comentario -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nombre del estudiante -->
        <TextView
            android:id="@+id/text_comment_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="usuario_ejemplo"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- Contenido del comentario -->
        <TextView
            android:id="@+id/text_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Este es un comentario de ejemplo para tu diseño."
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" />

        <!-- Fecha y acciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <!-- Fecha -->
            <TextView
                android:id="@+id/text_comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 2h"
                android:textSize="12sp"
                android:textColor="#999999" />

            <!-- Botón responder -->
            <TextView
                android:id="@+id/text_reply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Responder"
                android:textSize="12sp"
                android:textColor="@color/purple_200"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp" />

            <!-- Separador flexible -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Like -->
            <LinearLayout
                android:id="@+id/layout_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/img_like"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_corazon"
                    app:tint="#999999" />

                <TextView
                    android:id="@+id/text_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="12"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
