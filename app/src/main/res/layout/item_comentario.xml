<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp">

    <!-- Avatar del usuario -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_comment_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_user_avatar"
        app:civ_border_width="2dp"
        app:civ_border_color="#FBAE3C"
        android:layout_marginEnd="12dp"
        android:layout_gravity="top" />

    <!-- Contenedor principal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Encabezado: Nombre y opciones -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/text_comment_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="194dp"
                android:layout_toStartOf="@+id/img_options"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="usuario_ejemplo"
                android:textColor="#212121"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_options"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_opciones"
                android:contentDescription="Opciones"
                app:tint="#BDBDBD"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp" />
        </RelativeLayout>

        <!-- Contenido -->
        <TextView
            android:id="@+id/text_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Este es un comentario de ejemplo para tu diseño."
            android:textColor="#424242"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Ver más -->
        <TextView
            android:id="@+id/text_ver_mas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver más"
            android:textColor="#FBAE3C"
            android:textStyle="bold"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Footer: fecha, like y reporte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Fecha -->
            <TextView
                android:id="@+id/text_comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 2h"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:layout_marginEnd="16dp" />

            <!-- Like -->
            <LinearLayout
                android:id="@+id/layout_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="48dp">

                <ImageView
                    android:id="@+id/img_like"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_corazon"
                    app:tint="#BDBDBD" />

                <TextView
                    android:id="@+id/text_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="12"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Botón reportar comentario -->
            <LinearLayout
                android:id="@+id/layout_report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="48dp"/>

            <!-- Separador flexible -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F5F5F5" />
    </LinearLayout>
</LinearLayout>
