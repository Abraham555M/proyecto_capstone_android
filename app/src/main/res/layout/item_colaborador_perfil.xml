<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:backgroundTint="#FAFAFA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Avatar del Colaborador -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivAvatarColaborador"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_user_avatar"
            app:civ_border_width="2dp"
            app:civ_border_color="#FBAE3C"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Contenedor de Información -->
        <LinearLayout
            android:id="@+id/layoutInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/ivAvatarColaborador"
            app:layout_constraintEnd_toStartOf="@id/ivEstadoColaboracion"
            app:layout_constraintTop_toTopOf="@id/ivAvatarColaborador"
            app:layout_constraintBottom_toBottomOf="@id/ivAvatarColaborador">

            <!-- Nombre del Colaborador -->
            <TextView
                android:id="@+id/tvNombreColaborador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Juan Pérez García"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Email o Código -->
            <TextView
                android:id="@+id/tvEmailColaborador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="juan.perez@example.com"
                android:textSize="13sp"
                android:textColor="#757575"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- Fecha de Colaboración -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendario"
                    app:tint="#9E9E9E" />

                <TextView
                    android:id="@+id/tvFechaColaboracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desde: 15 Ene 2025"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Estado de Colaboración -->
        <ImageView
            android:id="@+id/ivEstadoColaboracion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_check"
            app:tint="#4CAF50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Badge de Estado (Opcional) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#E8F5E9"
            app:layout_constraintStart_toStartOf="@id/layoutInfo"
            app:layout_constraintTop_toBottomOf="@id/layoutInfo">

            <TextView
                android:id="@+id/tvEstadoColaboracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activo"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>