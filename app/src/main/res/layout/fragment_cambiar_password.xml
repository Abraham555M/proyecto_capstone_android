<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo con formas decorativas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_shapes" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:padding="24dp">

        <!-- Avatar circular -->
        <ImageView
            android:id="@+id/ivAvatarPass"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@drawable/circle_background_pink"
            android:scaleType="centerCrop"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="80dp" />

        <!-- Título (MISMO TEXTO) -->
        <TextView
            android:id="@+id/tvTituloPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Contraseña"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/ivAvatarPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcionPass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Por favor ingresa tu nueva contraseña"
            android:textSize="16sp"
            android:textColor="@color/gray_dark"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Nueva contraseña (MISMO ID) -->
        <EditText
            android:id="@+id/etNuevaPass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nueva contraseña"
            android:inputType="textPassword"
            android:background="@drawable/edittext_background_modern"
            android:padding="16dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Confirmar contraseña (MISMO ID) -->
        <EditText
            android:id="@+id/etConfirmarPass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Confirmar nueva contraseña"
            android:inputType="textPassword"
            android:background="@drawable/edittext_background_modern"
            android:padding="16dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/etNuevaPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Botón cambiar contraseña (MISMO ID) -->
        <Button
            android:id="@+id/btnCambiarPass"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Guardar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_orange_background"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/etConfirmarPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Botón cancelar -->
        <TextView
            android:id="@+id/btnCancelarPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textSize="16sp"
            android:textColor="@color/gray_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnCambiarPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>