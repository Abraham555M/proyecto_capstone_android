<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Formas decorativas de fondo -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-50dp"
        android:layout_marginStart="-50dp"
        android:background="@drawable/circle_orange_large" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="80dp"
        android:layout_marginStart="100dp"
        android:background="@drawable/circle_yellow_medium" />

    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="200dp"
        android:layout_marginEnd="-20dp"
        android:background="@drawable/circle_orange_small" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Avatar circular con fondo rosado -->
        <FrameLayout
            android:id="@+id/flAvatarContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/circle_background_pink"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="100dp">

            <ImageView
                android:id="@+id/ivAvatarPass"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user_avatar"
                app:tint="@color/black"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_image_background" />

        </FrameLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Contraseña"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/flAvatarContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcionPass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Por favor ingresa tu nueva contraseña"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <!-- Nueva contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNuevaPass"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nueva contraseña"
            app:boxBackgroundColor="#F3F4F6"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeWidth="0dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#9CA3AF"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#9CA3AF"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNuevaPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:textColor="#1F2937"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirmar contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmarPass"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Confirmar nueva contraseña"
            app:boxBackgroundColor="#F3F4F6"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeWidth="0dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#9CA3AF"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#9CA3AF"
            app:layout_constraintTop_toBottomOf="@id/tilNuevaPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:textColor="#1F2937"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarPass"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Guardar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="#FBAE3C"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tilConfirmarPass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="60dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>