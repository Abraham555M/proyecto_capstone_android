<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/dialog_background">

        <!-- Icono superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_error_background" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-36dp"
                android:src="@drawable/ic_error"
                app:tint="@color/error_color" />
        </LinearLayout>

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titulo del error"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text_color"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvMensajeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensaje del error"
            android:textSize="14sp"
            android:textColor="@color/secondary_text_color"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif" />

        <!-- Botón -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFuncionalidadError"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Okay"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/orange_circle"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="8dp"
            app:elevation="2dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>