<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_margin="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Header con acento de color -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- Barra de acento superior -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#FBAE3C"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="16dp" />

        </RelativeLayout>

        <!-- Contenido Principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Contenedor de la imagen con elevación moderna -->
            <androidx.cardview.widget.CardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F5F5F5">

                <ImageView
                    android:id="@+id/imgCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="Imagen de categoría" />

            </androidx.cardview.widget.CardView>

            <!-- Divider sutil -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:background="#F5F5F5"
                android:layout_marginBottom="12dp" />

            <!-- Nombre de la categoría -->
            <TextView
                android:id="@+id/txtNombreCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Nombre"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>