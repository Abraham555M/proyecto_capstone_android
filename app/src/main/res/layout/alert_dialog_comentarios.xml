<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:backgroundTint="#FFFFFF"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- Header Moderno -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerVertical="true">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="#FBAE3C"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comentarios"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close"
                app:tint="#757575"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp" />
        </RelativeLayout>

        <!-- Divider sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5" />

        <!-- RecyclerView con altura FIJA -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_comments"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_comentario" />

        <!-- Empty State Mejorado -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="40dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_comentario"
                app:tint="#C7C7C7"
                android:alpha="0.6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Aún no hay comentarios"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#424242"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sé el primero en compartir tu opinión"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:gravity="center" />
        </LinearLayout>

        <!-- Divider antes del input -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F5F5F5" />

        <!-- Input Section Moderno -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="#FFFFFF">

            <!-- Avatar con borde naranja -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_user_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user_avatar"
                app:civ_border_width="2dp"
                app:civ_border_color="#FBAE3C" />

            <!-- Container del EditText con fondo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/edit_text_background_modern"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingVertical="8dp">

                <EditText
                    android:id="@+id/etComentario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:maxHeight="100dp"
                    android:background="@android:color/transparent"
                    android:hint="Escribe un comentario..."
                    android:textColorHint="#BDBDBD"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:gravity="center_vertical"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <!-- Send Button con estilo moderno -->
            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FBAE3C">

                <ImageView
                    android:id="@+id/btnEnviarComentario"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_enviar"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    app:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>