<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:backgroundTint="#FFFFFF"
    android:layout_margin="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <!-- Header Moderno -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp"
                android:background="#FFFFFF"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_centerVertical="true">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#FBAE3C"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar Emprendimiento"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_close"
                    app:tint="#757575"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp" />
            </RelativeLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F5F5F5" />

            <!-- Contenido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Área de imagen con diseño moderno -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/containerImagen"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F8F8">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Imagen de preview -->
                        <ImageView
                            android:id="@+id/imgEditarPortada"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_placeholder"
                            android:contentDescription="Foto de portada"/>

                        <!-- Overlay con gradiente sutil -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/gradient_overlay"/>

                        <!-- Botón de cámara flotante -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnSeleccionarImagen"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="#FBAE3C">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_camara_emprendimiento"
                                android:padding="14dp"
                                android:scaleType="centerInside"
                                app:tint="#FFFFFF" />
                        </androidx.cardview.widget.CardView>

                        <!-- Texto indicador -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="72dp"
                            android:text="Cambiar foto"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:elevation="2dp"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="4"/>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Label Nombre con estilo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:background="#FBAE3C"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre del emprendimiento"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                </LinearLayout>

                <!-- EditText Nombre con diseño moderno -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_background_modern"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etEditarNombre"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:hint="Nombre de tu emprendimiento"
                        android:textColorHint="#BDBDBD"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Label Descripción con estilo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:background="#FBAE3C"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descripción"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                </LinearLayout>

                <!-- EditText Descripción con diseño moderno -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_background_modern"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etEditarDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:hint="Describe tu emprendimiento..."
                        android:textColorHint="#BDBDBD"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:scrollbars="vertical" />
                </LinearLayout>

                <!-- Botones de acción modernos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Botón Cancelar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F5F5F5">

                        <TextView
                            android:id="@+id/btnCancelar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Cancelar"
                            android:textColor="#757575"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />
                    </androidx.cardview.widget.CardView>

                    <!-- Botón Guardar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FBAE3C">

                        <TextView
                            android:id="@+id/btnGuardarCambios"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Guardar Cambios"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.cardview.widget.CardView>