<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clipToPadding="false"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/gray_light"
    app:strokeWidth="0dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 🔸 Header del emprendimiento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivEntrepreneurAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@color/gray_light" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvEntrepreneurName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                tools:text="Nombre emprendimiento" />

            <!-- Botón toggle de seguir -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFollow"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Seguir"
                android:textSize="10sp"
                android:paddingHorizontal="12dp"
                app:cornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gray_light"
                android:textColor="@color/gray_dark" />
        </LinearLayout>

        <!-- 🔸 Imagen principal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:foreground="?attr/selectableItemBackground"
                tools:src="@color/mint_green" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 🔸 Acciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivLike"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_corazon"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivComment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_comentario"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivMoreOptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_opciones"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivBookmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_favoritos"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp" />
        </LinearLayout>

        <!-- 🔸 Likes -->
        <TextView
            android:id="@+id/tvLikes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gray_dark"
            android:layout_marginBottom="4dp"
            tools:text="11,683 Me gusta" />

        <!-- 🔸 Título y precio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProductTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                tools:text="Titulo producto" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brown_light"
                android:layout_marginStart="8dp"
                tools:text="S/ 20.00" />
        </LinearLayout>

        <!-- 🔸 Descripción -->
        <TextView
            android:id="@+id/tvProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/gray_medium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Descripción breve del producto con un máximo de dos líneas..." />

        <TextView
            android:id="@+id/tvVerMas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver más"
            android:textSize="13sp"
            android:textColor="@color/teal_700"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <!-- ⚡ Sección PRODUCTO -->
        <LinearLayout
            android:id="@+id/sectionProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="8dp"
            android:background="@drawable/bg_section_card"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvPrecioProducto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Precio: S/ 0.00"
                android:textColor="@color/gray_dark"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStockProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: 0"
                android:textColor="@color/gray_dark"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ⚡ Sección EVENTO -->
        <LinearLayout
            android:id="@+id/sectionEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp"
            android:background="@drawable/bg_section_card"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendario"
                    app:tint="@color/teal_700"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvFechaEvento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha: 00/00/0000"
                    android:textColor="@color/gray_dark"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLugarEvento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lugar: ..."
                android:textColor="@color/gray_medium"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ⚡ Sección PROMOCIÓN -->
        <LinearLayout
            android:id="@+id/sectionPromocion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp"
            android:background="@drawable/bg_section_card"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_regalo"
                    app:tint="@color/brown_light"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvDescripcionPromocion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promoción especial"
                    android:textColor="@color/brown_light"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFechasPromocion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Válido del ... al ..."
                android:textColor="@color/gray_medium"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
